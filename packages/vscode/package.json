{
  "publisher": "jannchie",
  "name": "theme-jannchie",
  "displayName": "Jannchie Code Theme",
  "type": "module",
  "version": "3.1.1",
  "description": "Jannchie Code Theme for VS Code",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jannchie/vscode-theme",
    "directory": "packages/vscode"
  },
  "bugs": {
    "url": "https://github.com/jannchie/vscode-theme/issues"
  },
  "keywords": [
    "theme",
    "jannchie",
    "light",
    "dark"
  ],
  "categories": [
    "Themes"
  ],
  "icon": "icon.jpg",
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "icon.jpg",
    "themes"
  ],
  "engines": {
    "vscode": "^1.43.0"
  },
  "contributes": {
    "themes": [
      {
        "label": "Jannchie Code Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/jannchie-dark.json"
      },
      {
        "label": "Jannchie Code Dark Soft",
        "uiTheme": "vs-dark",
        "path": "./themes/jannchie-dark-soft.json"
      },
      {
        "label": "Jannchie Code Black",
        "uiTheme": "vs-dark",
        "path": "./themes/jannchie-black.json"
      },
      {
        "label": "Jannchie Code Light",
        "uiTheme": "vs",
        "path": "./themes/jannchie-light.json"
      },
      {
        "label": "Jannchie Code Light Soft",
        "uiTheme": "vs",
        "path": "./themes/jannchie-light-soft.json"
      }
    ]
  },
  "scripts": {
    "build": "esno src/index.ts",
    "dev": "esno watch src/index.ts",
    "vscode:prepublish": "pnpm build",
    "prepublishOnly": "pnpm build",
    "release": "vsce publish --no-dependencies"
  },
  "devDependencies": {
    "@jannchie/theme-core": "workspace:*"
  },
  "preview": true
}
