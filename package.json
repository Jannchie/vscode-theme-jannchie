{
  "publisher": "jannchie",
  "name": "theme-jannchie",
  "displayName": "Jannchie Theme",
  "type": "module",
  "version": "1.1.0",
  "packageManager": "pnpm@10.26.2+sha512.0e308ff2005fc7410366f154f625f6631ab2b16b1d2e70238444dd6ae9d630a8482d92a451144debc492416896ed16f7b114a86ec68b8404b2443869e68ffda6",
  "description": "Jannchie theme for VS Code",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jannchie/vscode-theme"
  },
  "bugs": {
    "url": "https://github.com/jannchie/vscode-theme/issues"
  },
  "keywords": [
    "theme",
    "jannchie",
    "light",
    "dark"
  ],
  "categories": [
    "Themes"
  ],
  "icon": "icon.jpg",
  "files": [
    "themes",
    "icon.jpg",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "vscode": "^1.43.0"
  },
  "contributes": {
    "themes": [
      {
        "label": "Jannchie Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/jannchie-dark.json"
      },
      {
        "label": "Jannchie Dark Soft",
        "uiTheme": "vs-dark",
        "path": "./themes/jannchie-dark-soft.json"
      },
      {
        "label": "Jannchie Black",
        "uiTheme": "vs-dark",
        "path": "./themes/jannchie-black.json"
      },
      {
        "label": "Jannchie Light",
        "uiTheme": "vs",
        "path": "./themes/jannchie-light.json"
      },
      {
        "label": "Jannchie Light Soft",
        "uiTheme": "vs",
        "path": "./themes/jannchie-light-soft.json"
      }
    ]
  },
  "scripts": {
    "build": "esno src/index.ts",
    "dev": "esno watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "vscode:prepublish": "pnpm build",
    "lint": "eslint .",
    "prepublishOnly": "pnpm build",
    "release": "vsce publish --no-dependencies"
  },
  "devDependencies": {
    "@antfu/utils": "^9.3.0",
    "@jannchie/eslint-config": "^3.7.6",
    "@types/color": "^4.2.1",
    "@types/node": "^25.5.0",
    "@vscode/vsce": "^3.7.1",
    "bumpp": "^11.0.1",
    "color": "^5.0.3",
    "eslint": "^10.1.0",
    "esno": "^4.8.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.1",
    "vitest": "^4.1.0"
  },
  "preview": true
}
