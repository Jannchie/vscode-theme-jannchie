{
  "name": "jannchie-theme-monorepo",
  "type": "module",
  "version": "1.1.0",
  "private": true,
  "packageManager": "pnpm@10.26.2+sha512.0e308ff2005fc7410366f154f625f6631ab2b16b1d2e70238444dd6ae9d630a8482d92a451144debc492416896ed16f7b114a86ec68b8404b2443869e68ffda6",
  "scripts": {
    "build": "pnpm --filter theme-jannchie build && pnpm --filter @jannchie/shiki-theme build",
    "build:shiki": "pnpm --filter @jannchie/shiki-theme build",
    "build:vscode": "pnpm --filter theme-jannchie build",
    "dev": "pnpm --filter theme-jannchie dev",
    "lint": "eslint .",
    "release:shiki": "pnpm --filter @jannchie/shiki-theme publish --access public",
    "release:vscode": "pnpm --filter theme-jannchie release",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@antfu/utils": "^9.3.0",
    "@jannchie/eslint-config": "^3.7.6",
    "@jannchie/theme-core": "workspace:*",
    "@types/color": "^4.2.1",
    "@types/node": "^25.5.0",
    "@vscode/vsce": "^3.7.1",
    "bumpp": "^11.0.1",
    "color": "^5.0.3",
    "eslint": "^10.1.0",
    "esno": "^4.8.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.1",
    "vitest": "^4.1.0"
  }
}
